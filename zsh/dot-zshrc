# ssh-agent: reuse a cached agent across shells; skip if a forwarded
# agent socket is already present. Uses ksshaskpass for passphrase prompts.
if [[ ! -S "$SSH_AUTH_SOCK" ]]; then
	_ssh_agent_env="$HOME/.ssh/environment-$HOST"
	[[ -f "$_ssh_agent_env" ]] && source "$_ssh_agent_env" >/dev/null
	if [[ ! -S "$SSH_AUTH_SOCK" ]]; then
		ssh-agent -s | sed '/^echo/d' >! "$_ssh_agent_env"
		chmod 600 "$_ssh_agent_env"
		source "$_ssh_agent_env" >/dev/null
	fi
	unset _ssh_agent_env
fi

for _id in id_rsa id_rsa2048 id_ed25519 id_ed25519_sk; do
	_key="$HOME/.ssh/$_id"
	[[ -f "$_key" ]] || continue
	ssh-add -l 2>/dev/null | grep -qF "$(ssh-keygen -lf "$_key" | awk '{print $2}')" \
		|| SSH_ASKPASS=ksshaskpass ssh-add "$_key" </dev/null
done
unset _id _key

typeset -U PATH path
_ZO_DOCTOR=0 eval "$(zoxide init --cmd cd zsh)"

# Fish-like autosuggestions and syntax highlighting (Arch packages, no
# plugin manager). Syntax highlighting must be sourced last -- it wraps
# every ZLE widget defined above it.
[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
